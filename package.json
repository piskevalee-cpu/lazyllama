{
  "name": "lazyllama",
  "version": "0.1.0",
  "description": "Intuitive keyboard-first TUI for llama.cpp (llama-server)",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun src/index.ts",
    "install": "bun src/install.ts",
    "install:server": "bun src/installer.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./test/*.test.ts"
  },
  "dependencies": {
    "@opentui/core": "0.5.12"
  },
  "devDependencies": {
    "typescript": "~5.6.0",
    "@types/node": "^22.0.0"
  }
}
